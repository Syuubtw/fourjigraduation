# Google API Credentials & Tokens (Crucial for Security)
/storage/app/google/*.json
!/storage/app/google/.gitkeep
*service-account*.json
*oauth-token*.json

# Cached Client Photos & Thumbnails
/storage/app/public/thumbnails/*
!/storage/app/public/thumbnails/.gitkeep
/storage/app/public/*
!/storage/app/public/.gitignore
!/storage/app/public/thumbnails

# Framework Storage & Logs
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/cache/locks/*
!/storage/framework/cache/locks/.gitignore
/storage/logs/*.log
